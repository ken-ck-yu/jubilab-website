{
  "name": "jubilab-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  // Wrangler creates this KV namespace on first deploy when no id is given.
  "kv_namespaces": [{ "binding": "WAITLIST" }],
  // Sends the signup notification to NOTIFY_TO. The address must be a verified Email Routing destination.
  // If hello@ is refused, change NOTIFY_TO to a personal verified address and make it a dashboard Secret instead.
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "NOTIFY_TO": "ken.ckyu@billybiotech.com" },
  // Preview builds (npx wrangler preview, non-production branches) need their own bindings block.
  "previews": {
    // Separate namespace so test signups on previews never land in the real waitlist (Previews share KV by id).
    "kv_namespaces": [{ "binding": "WAITLIST", "id": "3c3f5f8288ff4897af5863ea59e15bc2" }],
    "send_email": [{ "name": "EMAIL" }],
    "vars": { "NOTIFY_TO": "ken.ckyu@billybiotech.com" }
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "jubilab.io", "custom_domain": true }]
}
